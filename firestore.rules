rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActive() {
      return isSignedIn() && userDoc().status == 'active';
    }

    function isAdmin() {
      return isActive() && userDoc().role == 'admin';
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if isActive();
      allow create, delete: if isAdmin();
      // Admins can change anything. Non-admin active users (agents) may only
      // touch stock as a side effect of completing a sale — never price,
      // name, category, or active state.
      allow update: if isAdmin() ||
        (isActive() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'updatedAt']));
    }

    match /sales/{saleId} {
      // Admins review every sale; agents can only see their own.
      allow read: if isAdmin() ||
        (isActive() && resource.data.agentId == request.auth.uid);
      allow create: if isActive() && request.resource.data.agentId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /stock_movements/{movementId} {
      allow read: if isAdmin();
      allow create: if isActive();
      allow update, delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }
  }
}
